---
export interface Props {
  n: number;
  title?: string;
  status: 'written' | 'locked';
  href?: string;
}

const { n, title, status, href } = Astro.props;
const num = String(n).padStart(2, '0');
const url = href ?? `/55/${num}`;
const isLocked = status === 'locked';
---
<a class:list={['tile', isLocked ? 'locked' : 'written']} href={url} aria-label={`Rule ${num}${title ? `: ${title}` : ''}${isLocked ? ' — not yet written' : ''}`}>
  <span class="tile-num type-num">{num}</span>
  {isLocked && (
    <svg class="tile-lock" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17 10V7a5 5 0 0 0-10 0v3H5v12h14V10h-2Zm-8-3a3 3 0 0 1 6 0v3H9V7Z" fill="currentColor"/>
    </svg>
  )}
  <span class="tile-title">{title ?? (isLocked ? 'Coming' : '')}</span>
</a>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 1 / 1.15;
    padding: 14px 14px 16px;
    border: 1px solid transparent;
    transition: transform var(--t-med), border-color var(--t-med), background var(--t-med);
    overflow: hidden;
  }
  .tile.written {
    background: var(--ink);
    color: var(--paper);
  }
  .tile.locked {
    background: var(--lock-bg);
    color: var(--lock-text);
    border-color: rgba(107, 101, 92, 0.15);
  }
  .tile:hover {
    transform: translateY(-2px);
    border-color: var(--red);
  }
  .tile.written:hover {
    background: var(--ink);
  }
  .tile.locked:hover {
    background: #E7E1D3;
  }
  .tile-num {
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--red);
    font-variation-settings: "opsz" 96;
  }
  .tile.locked .tile-num {
    color: var(--lock-text);
    opacity: 0.65;
  }
  .tile-title {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: clamp(12px, 1.15vw, 14.5px);
    line-height: 1.15;
    letter-spacing: -0.005em;
    font-variation-settings: "opsz" 30, "SOFT" 30;
    text-wrap: balance;
  }
  .tile.locked .tile-title {
    font-family: var(--f-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .tile-lock {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 14px;
    height: 14px;
    color: var(--lock-text);
    opacity: 0.4;
  }
</style>
