---
const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath.startsWith(path);
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/">Tiago Carvalho</a>
    <nav aria-label="Primary">
      <ul class="nav-links">
        <li><a href="/55" class:list={[isActive('/55') && 'active']}>The 55</a></li>
        <li><a href="/notes" class:list={[isActive('/notes') && 'active']}>Notes</a></li>
        <li><a href="/book" class:list={[isActive('/book') && 'active']}>The book</a></li>
        <li>
          <a href="/work" class="nav-cta" class:list={[isActive('/work') && 'active']}>
            Work with me
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: var(--hair);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 18px;
  }
  .brand {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: 20px;
    letter-spacing: -0.005em;
    color: var(--ink);
    font-variation-settings: "opsz" 36, "SOFT" 30;
  }
  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 28px;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    font-family: var(--f-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-70);
    letter-spacing: 0.02em;
    transition: color var(--t-med);
  }
  .nav-links a:hover,
  .nav-links a.active {
    color: var(--ink);
  }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border: 1px solid var(--ink);
    color: var(--ink) !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase;
    transition: background var(--t-med), color var(--t-med);
  }
  .nav-cta:hover {
    background: var(--ink);
    color: var(--paper) !important;
  }
  /* Mobile */
  @media (max-width: 720px) {
    .nav-inner { flex-direction: column; gap: 12px; align-items: flex-start; padding-block: 14px; }
    .nav-links { gap: 18px; flex-wrap: wrap; }
    .nav-links a { font-size: 12px; }
    .nav-cta { padding: 8px 14px; font-size: 11px !important; }
  }
</style>
