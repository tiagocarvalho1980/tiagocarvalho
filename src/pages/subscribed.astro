---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="You're on the list — Tiago Carvalho"
  description="You're on the list. One email per new rule as it's written."
  noindex={true}
>
  <section class="section subscribed">
    <div class="wrap-read">
      <p class="type-kicker">You're on the list</p>
      <h1 class="type-display-l s-title">Welcome.</h1>

      <p class="type-body-l s-body">
        One email per new rule as it lands. Nothing else. Rule 10 is written and
        waiting — confirm your subscription in the email that just arrived, and it
        follows on. The others come one at a time from there.
      </p>

      <div class="s-note">
        <p class="type-caption">
          Didn't get the confirmation email yet? Check your promotions or spam folder.
          Without the confirm click, no rules land in your inbox.
        </p>
      </div>

      <div class="s-back">
        <a href="/55" class="link-underline arrow">See the doors</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .subscribed { padding-block: clamp(64px, 8vw, 120px); }
  .s-title { margin-top: 18px; text-wrap: balance; max-width: 20ch; }
  .s-body { margin-top: var(--s-5); color: var(--ink-70); max-width: 55ch; }
  .s-note {
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: var(--hair);
    max-width: 52ch;
  }
  .s-note p { font-style: italic; }
  .s-back { margin-top: var(--s-7); }
</style>
