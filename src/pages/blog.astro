---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailBand from '../components/EmailBand.astro';
import { getCollection } from 'astro:content';

const writtenRules = (await getCollection('entries'))
  .filter((e) => e.data.status === 'written');
const notes = await getCollection('notes');
const trending = await getCollection('trending');

type FeedItem = {
  kind: 'rule' | 'note' | 'trending';
  date: Date;
  title: string;
  slug: string;
  n?: number;
  d?: string;
  rule?: number;
};

const feed: FeedItem[] = [
  ...writtenRules.map((e: any): FeedItem => ({
    kind: 'rule',
    date: e.data.published ?? new Date(0),
    title: e.data.title,
    slug: `/55/${String(e.data.n).padStart(2, '0')}`,
    n: e.data.n,
  })),
  ...notes.map((n: any): FeedItem => ({
    kind: 'note',
    date: n.data.date,
    title: n.data.title,
    slug: `/notes/${n.id.replace(/\.md$/, '')}`,
    d: n.data.d,
    rule: n.data.rule,
  })),
  ...trending.map((t: any): FeedItem => ({
    kind: 'trending',
    date: t.data.date,
    title: t.data.title,
    slug: `/trending/${t.id.replace(/\.md$/, '')}`,
    rule: t.data.rule,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const totalEntries = (await getCollection('entries')).length;
const writtenCount = writtenRules.length;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tiago Carvalho',
  jobTitle: 'Writer. Sales strategist. Founder of HYPE.',
  url: 'https://tiagocarvalho.co/blog',
  sameAs: [
    'https://www.linkedin.com/in/tiagocarvalhoco',
    'https://www.instagram.com/tiagocarvalho.co',
    'https://x.com/tiagocarvalho',
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'HYPE',
    url: 'https://www.hypedigital.ie',
  },
};
---
<BaseLayout
  title="The 55 Blog — Tiago Carvalho"
  description="Fifty-five rules for selling, serving and starting again. One at a time, mixed with dated notes on what I'm watching. Every note ends on a rule."
  schema={schema}
>
  <!-- ================ HERO (COMPACT) ================ -->
  <section class="section blog-hero">
    <div class="wrap-read">
      <div class="bh-row">
        <figure class="bh-flap">
          <img src="/tiago.jpg" alt="Tiago Carvalho" width="112" height="140" loading="lazy" />
        </figure>
        <div class="bh-text">
          <p class="type-eyebrow bh-kicker">The 55 Blog</p>
          <h1 class="type-display-m bh-title">Rules. Notes. One a week.</h1>
          <p class="type-body bh-byline">
            Written by <b>Tiago Carvalho</b>. Fifty-five rules for selling, serving and
            starting again — one at a time, mixed with dated notes on what I'm watching
            in sales, hospitality and content. Every note ends on a rule.
          </p>
          <p class="type-caption bh-progress">
            <span class="bh-count">{String(writtenCount).padStart(2, '0')}</span>
            <span> of {totalEntries} rules written.</span>
            <span class="bh-dot">·</span>
            <a href="/55" class="bh-index-link">See the full index →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================ MIXED FEED ================ -->
  <section class="section-tight blog-feed">
    <div class="wrap-read">
      {feed.length === 0 ? (
        <div class="feed-empty">
          <p class="type-body">
            First rules and notes drop in September. Leave your email below to catch
            them.
          </p>
        </div>
      ) : (
        <ul class="feed">
          {feed.map((item) => (
            <li class={`feed-row feed-row--${item.kind}`}>
              <a href={item.slug} class="feed-link">
                <span class="feed-date type-caption">
                  {item.date.toLocaleDateString('en-GB', {
                    day: '2-digit', month: 'short', year: 'numeric',
                  })}
                </span>
                <span class={`feed-kind feed-kind--${item.kind} type-caption`}>
                  {item.kind === 'rule'
                    ? `Rule ${String(item.n).padStart(2, '0')}`
                    : item.kind === 'trending'
                      ? 'Trending'
                      : 'Note'}
                </span>
                <span class="feed-title type-display-s">{item.title}</span>
                {(item.kind === 'note' || item.kind === 'trending') && item.rule && (
                  <span class="feed-end type-caption">→ Rule {String(item.rule).padStart(2, '0')}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <EmailBand
    variant="band"
    kicker="The rules"
    heading="One at a time, as they're written."
    body="One email per new rule. Nothing else. Fifty-five in the end."
    label="Your email"
    button="Send me the rules"
  />
</BaseLayout>

<style>
  /* Hero */
  .blog-hero { padding-block: clamp(40px, 5vw, 72px) var(--s-5); }
  .bh-row {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: var(--s-5);
    align-items: start;
  }
  .bh-flap { margin: 0; }
  .bh-flap img {
    width: 112px;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 22%;
    display: block;
    filter: contrast(1.02) saturate(0.94);
    box-shadow:
      0 12px 24px -8px rgba(22, 21, 19, 0.22),
      0 4px 10px -4px rgba(22, 21, 19, 0.14);
  }
  .bh-text { padding-top: 4px; }
  .bh-kicker { margin-bottom: 10px; }
  .bh-title { margin-bottom: var(--s-3); text-wrap: balance; }
  .bh-byline {
    color: var(--ink-70);
    max-width: 54ch;
    margin-bottom: var(--s-4);
  }
  .bh-byline b { color: var(--ink); font-weight: 600; }
  .bh-progress {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
  }
  .bh-count {
    color: var(--red);
    font-family: var(--f-display);
    font-weight: 500;
    font-size: 15px;
    font-feature-settings: "tnum";
  }
  .bh-dot { color: var(--ink-45); padding-inline: 4px; }
  .bh-index-link {
    color: var(--ink-70);
    border-bottom: 1px solid var(--ink-15);
    padding-bottom: 1px;
    transition: color var(--t-med), border-color var(--t-med);
  }
  .bh-index-link:hover { color: var(--red); border-bottom-color: var(--red); }
  @media (max-width: 560px) {
    .bh-row { grid-template-columns: 1fr; }
    .bh-flap img { width: 96px; }
  }

  /* Feed */
  .blog-feed { padding-block: var(--s-5) clamp(56px, 7vw, 96px); }
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--hair);
  }
  .feed-row { border-bottom: var(--hair); }
  .feed-link {
    display: grid;
    grid-template-columns: 118px 92px 1fr auto;
    align-items: baseline;
    gap: var(--s-5);
    padding: var(--s-5) 0;
    transition: background var(--t-med), padding var(--t-med);
  }
  .feed-link:hover { background: var(--ink-08); padding-inline: var(--s-3); }
  .feed-date {
    color: var(--ink-45);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 11px;
    font-weight: 600;
    font-feature-settings: "tnum";
  }
  .feed-kind {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 11px;
    font-weight: 600;
  }
  .feed-kind--rule { color: var(--red); }
  .feed-kind--note { color: var(--ink); }
  .feed-kind--trending { color: var(--brass); }
  .feed-title { color: var(--ink); text-wrap: balance; }
  .feed-end {
    color: var(--red);
    font-weight: 600;
    letter-spacing: 0.18em;
    font-size: 11px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .feed-empty {
    padding: var(--s-5) 0 0;
    color: var(--ink-70);
    max-width: 52ch;
  }
  @media (max-width: 720px) {
    .feed-link {
      grid-template-columns: 118px 1fr;
      grid-template-rows: auto auto;
      row-gap: 4px;
      column-gap: var(--s-4);
      padding-block: var(--s-4);
    }
    .feed-kind { grid-row: 1 / 2; grid-column: 2 / 3; }
    .feed-title { grid-row: 2 / 3; grid-column: 1 / -1; }
    .feed-end { grid-row: 1 / 2; grid-column: 2 / 3; justify-self: end; }
    .feed-kind + .feed-end { display: none; }
  }
</style>
