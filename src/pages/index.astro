---
import WorkLayout from '../layouts/WorkLayout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'The 55 Method — AI sales & marketing training for companies',
  url: 'https://tiagocarvalho.co',
  serviceType: [
    'AI sales training',
    'AI marketing training',
    'Keynote speaking',
  ],
  provider: {
    '@type': 'Person',
    name: 'Tiago Carvalho',
    url: 'https://tiagocarvalho.co',
  },
  areaServed: 'Worldwide',
};

const covers = [
  'AI prospect research',
  'AI call prep & openers',
  'Discovery questions',
  'Objections with an AI roleplay partner',
  'Calling for the sale',
  'AI follow-up & proposals',
  'Content in an hour a day',
  'AI avatars & personal video',
  'Selling on camera',
  "Your team's prompt library",
  'Using AI content honestly & legally',
  'Mindset & the 55-day habit',
];
---
<WorkLayout
  title="AI Sales & Marketing Training for Companies — Tiago Carvalho"
  description="The 55 Method trains sales and marketing teams to research, pitch, follow up and create with AI — and then close. In 55 days."
  ogImage="/og-image-work.jpg"
  schema={schema}
>
  <!-- ============================================================
       6.2 — HERO
       ============================================================ -->
  <section class="section-co co-hero">
    <div class="wrap-co">
      <p class="t-meta t-meta-gold hero-eyebrow">
        <span class="eyebrow-rule" aria-hidden="true"></span>
        AI Sales &amp; Marketing Training · For Companies
      </p>
      <h1 class="t-display-xxl hero-h1">
        Your team, selling and creating<br class="desk-br" />
        with AI. <span class="accent">In 55&nbsp;days.</span>
      </h1>
      <p class="t-body-l muted hero-sub">
        The 55 Method trains sales and marketing teams to research, pitch, follow up and
        make content with AI — and then close. Built by a sales leader who produces AI
        content for brands every day.
      </p>
      <div class="hero-ctas">
        <a class="btn-co" href="#book">Book a discovery call</a>
        <a class="btn-ghost btn-co arrow-co" href="#programs">See the programs</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       6.3 — PROOF BAR
       ============================================================ -->
  <section class="section-co co-proof" aria-label="Credentials">
    <div class="wrap-co">
      <div class="proof-grid">
        <div class="stat">
          <span class="t-display-m accent stat-num">€2M → €10.2M</span>
          <span class="t-body-s muted stat-line">
            Business accounts grown in three years, leading international hotel sales
          </span>
        </div>
        <div class="stat">
          <span class="t-display-m accent stat-num">4</span>
          <span class="t-body-s muted stat-line">
            Sales teams built from zero, plus the SOPs directors used across three
            continents
          </span>
        </div>
        <div class="stat">
          <span class="t-display-m accent stat-num">Daily</span>
          <span class="t-body-s muted stat-line">
            Films, avatars and campaigns produced for brands at HYPE, my Media Agency
            in Ireland
          </span>
        </div>
        <div class="stat">
          <span class="t-display-m accent stat-num">20&nbsp;yrs</span>
          <span class="t-body-s muted stat-line">
            Selling — reception desks, nightclubs, hotels, a Media Agency
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       6.4 — PROBLEM
       ============================================================ -->
  <section class="section-co co-problem">
    <div class="wrap-co">
      <p class="t-meta t-meta-gold problem-label">— Sound familiar?</p>
      <h2 class="t-display-l problem-h2">
        Everyone bought AI.<br />
        Nobody sells more<br class="mob-br" /> with it.
      </h2>
      <div class="problem-grid">
        <article class="prob-card">
          <span class="t-meta prob-num">01</span>
          <h3 class="t-display-s prob-title">AI is a licence, not a habit</h3>
          <p class="t-body muted prob-body">
            The tools are paid for. A few people play with them. The pipeline looks
            exactly the same.
          </p>
        </article>
        <article class="prob-card">
          <span class="t-meta prob-num">02</span>
          <h3 class="t-display-s prob-title">Content takes weeks</h3>
          <p class="t-body muted prob-body">
            Every video, deck and post waits on an agency or one overloaded person.
            Sales asks; marketing queues.
          </p>
        </article>
        <article class="prob-card">
          <span class="t-meta prob-num">03</span>
          <h3 class="t-display-s prob-title">Every rep sells differently</h3>
          <p class="t-body muted prob-body">
            No shared method, so AI just helps people make the same mistakes faster.
          </p>
        </article>
        <article class="prob-card">
          <span class="t-meta prob-num">04</span>
          <h3 class="t-display-s prob-title">Training doesn't stick</h3>
          <p class="t-body muted prob-body">
            One exciting AI workshop, back to old habits by Monday. Behaviour changes
            in weeks, not hours.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================================
       6.5 — METHOD (LIGHT SECTION)
       ============================================================ -->
  <section id="method" class="section-co co-method">
    <div class="wrap-co">
      <p class="t-meta method-label">— The 55 Method</p>
      <h2 class="t-display-l method-h2">
        Four beats to every sale.<br />
        AI in every beat.<br />
        <span class="method-accent">55 days to make it a habit.</span>
      </h2>
      <p class="t-body-l method-intro">
        Any habit holds if you do it 55 days straight. So the program doesn't end on
        training day — that's where it starts.
      </p>

      <ol class="beats">
        <li class="beat">
          <div class="beat-letter">A</div>
          <div class="beat-body">
            <h3 class="t-display-m beat-title">Access</h3>
            <p class="t-body-l beat-line">Earn the first ten seconds.</p>
            <p class="t-body beat-ai">
              <span class="t-meta beat-ai-label">With AI</span>
              research every prospect and write the opener before the call.
            </p>
          </div>
        </li>
        <li class="beat">
          <div class="beat-letter">G</div>
          <div class="beat-body">
            <h3 class="t-display-m beat-title">Guide</h3>
            <p class="t-body-l beat-line">Lead with questions. The buyer talks; you steer.</p>
            <p class="t-body beat-ai">
              <span class="t-meta beat-ai-label">With AI</span>
              discovery questions built from the buyer's own business.
            </p>
          </div>
        </li>
        <li class="beat">
          <div class="beat-letter">A</div>
          <div class="beat-body">
            <h3 class="t-display-m beat-title">Address</h3>
            <p class="t-body-l beat-line">Meet the real objection, not the polite one.</p>
            <p class="t-body beat-ai">
              <span class="t-meta beat-ai-label">With AI</span>
              a live objection bank and roleplay partner for every rep.
            </p>
          </div>
        </li>
        <li class="beat">
          <div class="beat-letter">C</div>
          <div class="beat-body">
            <h3 class="t-display-m beat-title">Call for the sale</h3>
            <p class="t-body-l beat-line">Ask. Every time.</p>
            <p class="t-body beat-ai">
              <span class="t-meta beat-ai-label">With AI</span>
              same-day follow-up, proposal and personal video — sent before the
              competitor replies.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============================================================
       6.6 — PROGRAMS & PRICING
       ============================================================ -->
  <section id="programs" class="section-co co-programs">
    <div class="wrap-co">
      <p class="t-meta t-meta-gold programs-label">— Programs</p>
      <h2 class="t-display-l programs-h2">
        Clear prices. Built around your team.
      </h2>
      <p class="t-body-l muted programs-sub">
        Every engagement starts with a free discovery call. Prices are per team, plus
        travel.
      </p>

      <div class="prog-grid">
        <!-- Keynote -->
        <article class="prog-card">
          <header class="prog-head">
            <p class="t-meta prog-name">Keynote</p>
            <p class="t-display-l prog-price">from €3,600</p>
            <p class="t-body-s muted prog-tag"><em>Open their eyes.</em></p>
          </header>
          <p class="t-body prog-blurb">
            45–60 minutes for a sales kick-off, conference or company event. Includes a
            live AI sale on stage.
          </p>
          <ul class="prog-list">
            <li>Briefing call and tailored content</li>
            <li>Live AI demo using your own product</li>
            <li>Live Q&amp;A</li>
          </ul>
          <a href="#book" class="btn-ghost btn-co prog-cta arrow-co">Check availability</a>
        </article>

        <!-- The 55-Day Program (highlighted) -->
        <article class="prog-card prog-card--star">
          <span class="prog-ribbon t-meta">Most chosen</span>
          <header class="prog-head">
            <p class="t-meta t-meta-gold prog-name">The 55-Day Program</p>
            <p class="t-display-l prog-price accent">from €18,000</p>
            <p class="t-body-s muted prog-tag"><em>Change the team.</em></p>
          </header>
          <p class="t-body prog-blurb">
            Two on-site days plus six live sessions across 55 days. Your team leaves
            with an AI sales playbook and the habit to use it.
          </p>
          <ul class="prog-list">
            <li>Audit of real calls, emails, content and tools</li>
            <li>2 on-site days + 6 live online sessions</li>
            <li>Your AI sales playbook and prompt library, written with your managers</li>
            <li>Content module: video, avatars and posts in under an hour a day</li>
            <li>WhatsApp, Slack or Teams support for 55 days</li>
            <li>Manager coaching and a day-55 scorecard</li>
          </ul>
          <a href="#book" class="btn-co prog-cta">Book a discovery call</a>
        </article>

        <!-- AI Workshop day -->
        <article class="prog-card">
          <header class="prog-head">
            <p class="t-meta prog-name">AI Workshop day</p>
            <p class="t-display-l prog-price">from €6,570</p>
            <p class="t-body-s muted prog-tag"><em>One day, one skill.</em></p>
          </header>
          <p class="t-body prog-blurb">
            A full hands-on day on-site. Everyone leaves with work they made. Pick a track:
          </p>
          <ul class="prog-list">
            <li><strong>AI selling:</strong> prospect research, call prep, objections, follow-up</li>
            <li><strong>AI content:</strong> video, avatars, posts and decks for marketing teams</li>
            <li><strong>AI for service teams:</strong> front-line people who upsell and follow up</li>
          </ul>
          <a href="#book" class="btn-ghost btn-co prog-cta arrow-co">Choose a track</a>
        </article>
      </div>

      <!-- Day-55 guarantee strip -->
      <div class="guarantee">
        <div class="guarantee-copy">
          <p class="t-meta t-meta-gold">The day-55 guarantee</p>
          <p class="t-body guarantee-body">
            If your team isn't using the method and the AI playbook on day 55, I come
            back and run another on-site day. No invoice.
          </p>
        </div>
        <p class="t-meta guarantee-cap">Max. 3 programs per quarter</p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       6.7 — WHAT WE COVER
       ============================================================ -->
  <section class="section-co co-covers" aria-labelledby="covers-heading">
    <div class="wrap-co">
      <p class="t-meta t-meta-gold covers-label">— What we cover</p>
      <h2 id="covers-heading" class="t-display-m covers-h2">
        Every module your team can run on Monday.
      </h2>
      <ul class="covers-list">
        {covers.map((item) => <li class="cover-chip t-body-s">{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- ============================================================
       6.9 — KEYNOTES
       ============================================================ -->
  <section id="keynotes" class="section-co co-keynotes">
    <div class="wrap-co">
      <p class="t-meta t-meta-gold keynotes-label">— Keynotes</p>
      <h2 class="t-display-l keynotes-h2">
        Three talks. Each one ends<br />
        <span class="accent">with something to do.</span>
      </h2>

      <ol class="talks">
        <li class="talk">
          <div class="talk-marker">AI</div>
          <div class="talk-body">
            <h3 class="t-display-m talk-title">
              AI won't replace your sales team. A team using AI will.
            </h3>
            <p class="t-body muted talk-blurb">
              Live on stage: one prospect, researched, pitched and followed up with AI
              in ten minutes. Then the rules for doing it every day.
            </p>
          </div>
        </li>
        <li class="talk">
          <div class="talk-marker">10</div>
          <div class="talk-body">
            <h3 class="t-display-m talk-title">
              Opportunity rarely introduces itself properly.
            </h3>
            <p class="t-body muted talk-blurb">
              Why the people who win say yes before it makes sense — and how a team
              learns to spot the door nobody labelled.
            </p>
          </div>
        </li>
        <li class="talk">
          <div class="talk-marker">55</div>
          <div class="talk-body">
            <h3 class="t-display-m talk-title">
              Aggressive seller. Soft words.
            </h3>
            <p class="t-body muted talk-blurb">
              From a reception desk to leading four sales teams: how to push for
              the close without ever sounding like it.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============================================================
       6.10 — ABOUT
       ============================================================ -->
  <section class="section-co co-about">
    <div class="wrap-co">
      <div class="about-grid">
        <figure class="about-portrait">
          <img src="/tiago-dark.jpg" alt="Tiago Carvalho" width="400" height="500" loading="lazy" />
        </figure>

        <div class="about-copy">
          <p class="t-meta t-meta-gold about-label">— Who's in the room</p>
          <h2 class="t-display-l about-h2">Tiago Carvalho</h2>
          <div class="about-body">
            <p class="t-body-l">
              I started on a reception desk and turned it into a national brand.
              Built a nightclub, lost it, started again.
            </p>
            <p class="t-body-l">
              Then eleven years in international hotel sales: from answering
              reservation calls to leading four teams, writing the sales SOPs
              directors used across three continents, and growing business accounts
              from €2M to €10.2M.
            </p>
            <p class="t-body-l">
              Today I run HYPE, my Media Agency in Ireland, making films, avatars and
              campaigns for brands. When I teach AI, I teach what I used this morning.
            </p>
            <p class="t-body-l about-lock">
              The 55 Method is the sales part and the AI part, written down so your
              team can use both.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       6.11 — BOOKING (gold section)
       ============================================================ -->
  <section id="book" class="co-book">
    <div class="wrap-co">
      <div class="book-head">
        <h2 class="t-display-xl book-h2">
          Your team's best quarter<br />
          starts with one call.
        </h2>
        <p class="t-body-l book-sub">
          Thirty minutes. I'll ask about your numbers, your team and the AI tools you
          already pay for. You'll leave with one thing to fix this week — whether we
          work together or not.
        </p>
      </div>

      <form class="book-form" action="{{FORM_HANDLER_URL}}" method="post" novalidate>
        <div class="fld">
          <label for="bf-name">Name</label>
          <input id="bf-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="fld">
          <label for="bf-email">Work email</label>
          <input id="bf-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="fld">
          <label for="bf-company">Company</label>
          <input id="bf-company" name="company" type="text" autocomplete="organization" required />
        </div>
        <fieldset class="fld" style="border:0; padding:0;">
          <legend>Size of the team to train</legend>
          <div class="opts-co">
            <label><input type="radio" name="team_size" value="1-10" required /> <span>1–10</span></label>
            <label><input type="radio" name="team_size" value="11-30" /> <span>11–30</span></label>
            <label><input type="radio" name="team_size" value="31-100" /> <span>31–100</span></label>
            <label><input type="radio" name="team_size" value="100+" /> <span>100+</span></label>
          </div>
        </fieldset>
        <fieldset class="fld" style="border:0; padding:0;">
          <legend>What are you looking for?</legend>
          <div class="opts-co">
            <label><input type="radio" name="interest" value="55-day" required /> <span>The 55-Day Program</span></label>
            <label><input type="radio" name="interest" value="workshop" /> <span>AI Workshop day</span></label>
            <label><input type="radio" name="interest" value="keynote" /> <span>Keynote</span></label>
            <label><input type="radio" name="interest" value="not-sure" /> <span>Not sure yet</span></label>
          </div>
        </fieldset>
        <button type="submit" class="btn-co btn-ghost-light book-submit">Book my discovery call</button>
        <p class="t-body-s book-fine">
          I reply within two working days. If we're a fit, you'll get three times to pick
          from.
        </p>
      </form>
    </div>
  </section>
</WorkLayout>

<style>
  /* ============================================================
     HERO
     ============================================================ */
  .co-hero { padding-block: clamp(72px, 10vw, 160px) clamp(56px, 8vw, 120px); }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-bottom: var(--co-s-6);
  }
  .eyebrow-rule {
    display: inline-block;
    width: 36px;
    height: 1px;
    background: var(--co-gold);
  }
  .hero-h1 {
    max-width: 15ch;
    margin-bottom: var(--co-s-6);
    text-wrap: balance;
  }
  .hero-sub { max-width: 56ch; margin-bottom: var(--co-s-7); }
  .hero-ctas {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  @media (max-width: 720px) {
    .desk-br { display: none; }
  }

  /* ============================================================
     PROOF BAR
     ============================================================ */
  .co-proof {
    padding-block: var(--co-s-8);
    border-block: 1px solid var(--co-rule);
  }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .stat {
    padding: var(--co-s-5) var(--co-s-5);
    border-right: 1px solid var(--co-rule);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .stat:last-child { border-right: 0; }
  .stat-num { line-height: 1; letter-spacing: -0.01em; }
  .stat-line { max-width: 32ch; }
  .stat:first-child { padding-left: 0; }
  @media (max-width: 820px) {
    .proof-grid { grid-template-columns: repeat(2, 1fr); }
    .stat { padding-inline: var(--co-s-4); border-bottom: 1px solid var(--co-rule); }
    .stat:nth-child(2) { border-right: 0; }
    .stat:nth-child(3), .stat:nth-child(4) { border-bottom: 0; }
    .stat:nth-child(odd) { padding-left: 0; }
  }

  /* ============================================================
     PROBLEM
     ============================================================ */
  .co-problem { padding-block: clamp(72px, 10vw, 128px); }
  .problem-label { margin-bottom: var(--co-s-5); }
  .problem-h2 { max-width: 16ch; margin-bottom: var(--co-s-8); text-wrap: balance; }
  .problem-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--co-rule);
    border-left: 1px solid var(--co-rule);
  }
  .prob-card {
    padding: var(--co-s-6) var(--co-s-6);
    border-right: 1px solid var(--co-rule);
    border-bottom: 1px solid var(--co-rule);
    display: flex;
    flex-direction: column;
    gap: var(--co-s-3);
    transition: background var(--co-t-med);
  }
  .prob-card:hover { background: rgba(201, 162, 39, 0.04); }
  .prob-num { color: var(--co-gold); }
  .prob-title { color: var(--co-bone); max-width: 24ch; }
  .prob-body { max-width: 42ch; }
  @media (max-width: 720px) {
    .problem-grid { grid-template-columns: 1fr; }
    .mob-br { display: none; }
  }

  /* ============================================================
     METHOD (LIGHT)
     ============================================================ */
  .co-method {
    background: var(--co-paper);
    color: var(--co-ink);
    padding-block: clamp(80px, 10vw, 160px);
  }
  .co-method .t-body-l,
  .co-method .t-body { color: var(--co-ink); }
  .method-label {
    color: #B0601C;
    margin-bottom: var(--co-s-5);
  }
  .method-h2 {
    color: var(--co-ink);
    max-width: 18ch;
    margin-bottom: var(--co-s-6);
    text-wrap: balance;
  }
  .method-accent { color: #B0601C; }
  .method-intro {
    max-width: 56ch;
    margin-bottom: var(--co-s-9);
    color: var(--co-ink);
  }
  .beats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid rgba(10, 10, 10, 0.14);
  }
  .beat {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--co-s-6);
    padding-block: var(--co-s-7);
    border-bottom: 1px solid rgba(10, 10, 10, 0.14);
    align-items: start;
  }
  .beat-letter {
    font-family: var(--co-f-display);
    font-size: clamp(96px, 10vw, 168px);
    line-height: 0.85;
    color: var(--co-ink);
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .beat-title { margin-bottom: var(--co-s-3); color: var(--co-ink); }
  .beat-line { margin-bottom: var(--co-s-4); color: var(--co-ink); max-width: 50ch; }
  .beat-ai {
    color: #4A443B;
    max-width: 60ch;
    display: block;
  }
  .beat-ai-label {
    display: inline-block;
    margin-right: 8px;
    color: #B0601C;
    padding: 3px 8px;
    border: 1px solid #B0601C;
  }
  @media (max-width: 720px) {
    .beat { grid-template-columns: 1fr; gap: var(--co-s-4); }
  }

  /* ============================================================
     PROGRAMS
     ============================================================ */
  .co-programs { padding-block: clamp(80px, 10vw, 160px); }
  .programs-label { margin-bottom: var(--co-s-5); }
  .programs-h2 { max-width: 20ch; margin-bottom: var(--co-s-5); text-wrap: balance; }
  .programs-sub { max-width: 56ch; margin-bottom: var(--co-s-8); }

  .prog-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr 1fr;
    gap: var(--co-s-5);
    align-items: stretch;
  }
  .prog-card {
    position: relative;
    padding: var(--co-s-6) var(--co-s-5);
    border: 1px solid var(--co-rule);
    display: flex;
    flex-direction: column;
    gap: var(--co-s-4);
    transition: border-color var(--co-t-med);
  }
  .prog-card:hover { border-color: var(--co-rule-strong); }
  .prog-card--star {
