---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmailBand from '../../components/EmailBand.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('trending');
  return items.map((item) => ({
    params: { slug: item.id.replace(/\.md$/, '') },
    props: { item },
  }));
}

const { item } = Astro.props as { item: any };
const { Content } = await render(item);

// Prev / next by date within trending
const all = (await getCollection('trending')).sort(
  (a: any, b: any) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const idx = all.findIndex((n: any) => n.id === item.id);
const prev = all[idx - 1];
const next = all[idx + 1];

// If this essay closes on a rule, load it for the rule card
let ruleTitle: string | undefined;
let isRuleWritten = false;
let ruleNum = '';
if (item.data.rule) {
  const entries = await getCollection('entries');
  const rule = entries.find((e: any) => e.data.n === item.data.rule);
  ruleTitle = rule?.data.title;
  isRuleWritten = rule?.data.status === 'written';
  ruleNum = String(item.data.rule).padStart(2, '0');
}

const pageTitle = `${item.data.title} — Tiago Carvalho`;
const pageDescription = item.data.description ?? item.data.title;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: item.data.title,
  description: item.data.description,
  author: {
    '@type': 'Person',
    name: 'Tiago Carvalho',
    url: 'https://tiagocarvalho.co/blog',
  },
  datePublished: item.data.date.toISOString(),
  articleSection: 'Trending',
  keywords: item.data.keywords?.join(', '),
};

const dateFmt = item.data.date.toLocaleDateString('en-GB', {
  day: '2-digit', month: 'long', year: 'numeric',
});
---
<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <article class="essay">
    <div class="wrap-read">
      <div class="essay-kicker">
        <span class="type-kicker">Trending · {dateFmt}</span>
        {item.data.reading_time && (
          <span class="type-caption essay-rt">{item.data.reading_time}</span>
        )}
      </div>

      <h1 class="type-display-l essay-h1">{item.data.title}</h1>

      <div class="essay-body">
        <Content />
      </div>

      {item.data.rule && (
        <div class="rule-card">
          <p class="type-eyebrow rc-label">This closes on</p>
          <a class="rc-link" href={`/55/${ruleNum}`}>
            <span class="rc-num type-num">{ruleNum}</span>
            <span class="rc-title">
              {isRuleWritten && ruleTitle ? ruleTitle : `Rule ${ruleNum}`}
            </span>
            <span class="rc-arrow">Read the rule &rarr;</span>
          </a>
        </div>
      )}

      <EmailBand
        variant="inline"
        kicker=""
        heading="Rules and essays, in your inbox."
        body=""
        label="Your email"
        button="Send"
      />

      <nav class="essay-nav" aria-label="Trending navigation">
        {(!prev && !next) ? (
          <a class="en-link en-all" href="/trending">
            <span class="type-caption en-label">All trending</span>
            <span class="en-title">→</span>
          </a>
        ) : (
          <Fragment>
            {prev ? (
              <a class="en-link en-prev" href={`/trending/${prev.id.replace(/\.md$/, '')}`}>
                <span class="type-caption en-label">Previous</span>
                <span class="en-title">{prev.data.title}</span>
              </a>
            ) : <span />}
            {next ? (
              <a class="en-link en-next" href={`/trending/${next.id.replace(/\.md$/, '')}`}>
                <span class="type-caption en-label">Next</span>
                <span class="en-title">{next.data.title}</span>
              </a>
            ) : <span />}
          </Fragment>
        )}
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .essay { padding-block: clamp(48px, 6vw, 88px) 0; }

  .essay-kicker {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: var(--s-4);
    border-bottom: var(--hair);
  }
  .essay-rt {
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 11px;
    color: var(--ink-45);
  }
  .essay-h1 {
    margin-top: var(--s-6);
    text-wrap: balance;
    max-width: 22ch;
  }

  /* Long-form body */
  .essay-body {
    margin-top: var(--s-6);
    max-width: 680px;
  }
  .essay-body :global(> p) {
    font-family: var(--f-body);
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink);
    margin-bottom: var(--s-5);
  }
  .essay-body :global(> p:first-of-type) {
    font-size: 21px;
    line-height: 1.55;
    color: var(--ink);
  }
  .essay-body :global(h2) {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: clamp(26px, 2.6vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.005em;
    margin-top: var(--s-9);
    margin-bottom: var(--s-4);
    padding-top: var(--s-5);
    border-top: var(--hair);
    color: var(--ink);
    font-variation-settings: "opsz" 36, "SOFT" 30;
    text-wrap: balance;
  }
  .essay-body :global(h3) {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.2;
    margin-top: var(--s-6);
    margin-bottom: var(--s-3);
    color: var(--ink);
    font-variation-settings: "opsz" 30, "SOFT" 30;
  }
  .essay-body :global(strong) { color: var(--ink); font-weight: 600; }
  .essay-body :global(em) { font-style: italic; color: var(--ink); }
  .essay-body :global(a) {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--red);
    padding-bottom: 1px;
    transition: color var(--t-med), border-color var(--t-med);
  }
  .essay-body :global(a:hover),
  .essay-body :global(a:focus-visible) {
    color: var(--red);
    border-bottom-color: var(--ink);
    outline: none;
  }

  /* Lists */
  .essay-body :global(ol),
  .essay-body :global(ul) {
    padding-left: 0;
    margin: 0 0 var(--s-5);
    list-style-position: outside;
    counter-reset: li-counter;
  }
  .essay-body :global(ol) { list-style: none; }
  .essay-body :global(ol > li) {
    counter-increment: li-counter;
    position: relative;
    padding-left: 36px;
    margin-bottom: var(--s-3);
    font-size: 18px;
    line-height: 1.65;
    color: var(--ink);
  }
  .essay-body :global(ol > li::before) {
    content: counter(li-counter) ".";
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--f-display);
    font-weight: 500;
    color: var(--red);
    font-feature-settings: "tnum";
  }
  .essay-body :global(ul) { list-style: none; }
  .essay-body :global(ul > li) {
    position: relative;
    padding-left: 24px;
    margin-bottom: var(--s-3);
    font-size: 18px;
    line-height: 1.65;
    color: var(--ink);
  }
  .essay-body :global(ul > li::before) {
    content: "";
    position: absolute;
    left: 0; top: 14px;
    width: 12px;
    height: 1px;
    background: var(--red);
  }

  /* Blockquote — used for the key formula */
  .essay-body :global(blockquote) {
    margin: var(--s-6) 0;
    padding: var(--s-5) var(--s-5);
    background: #141414;
    border-left: 3px solid var(--red);
    color: var(--ink);
  }
  .essay-body :global(blockquote p) {
    margin: 0;
    font-family: var(--f-display);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.4;
    font-variation-settings: "opsz" 36, "SOFT" 30;
  }

  /* Tables */
  .essay-body :global(table) {
    width: 100%;
    margin: var(--s-6) 0;
    border-collapse: collapse;
    font-family: var(--f-body);
    font-size: 15px;
    border-top: 1px solid var(--red);
    border-bottom: 1px solid var(--ink-15);
  }
  .essay-body :global(th) {
    text-align: left;
    padding: 12px 14px 14px 0;
    border-bottom: 1px solid var(--ink-15);
    font-family: var(--f-body);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--red);
    vertical-align: top;
  }
  .essay-body :global(td) {
    padding: 14px 14px 14px 0;
    border-bottom: 1px solid var(--ink-08);
    color: var(--ink);
    vertical-align: top;
  }
  .essay-body :global(tr:last-child td) { border-bottom: 0; }
  .essay-body :global(td:not(:first-child)),
  .essay-body :global(th:not(:first-child)) {
    padding-left: 14px;
  }

  /* FAQ H3 treatment — questions get a brass marker */
  .essay-body :global(h2 + h3) { /* first h3 after h2 */ }

  /* Sources section — the "## Sources" h2 and the list beneath */
  .essay-body :global(.sources-head) {
    margin-top: var(--s-9);
    margin-bottom: var(--s-3);
    padding-top: var(--s-5);
    border-top: var(--hair);
    font-family: var(--f-body);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--red);
  }
  .essay-body :global(.sources-head + ul) { margin-top: var(--s-3); }
  .essay-body :global(.sources-head + ul > li) {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-70);
    margin-bottom: var(--s-3);
  }
  .essay-body :global(.sources-head + ul > li a) {
    color: var(--ink);
    border-bottom-color: var(--ink-15);
  }
  .essay-body :global(.sources-head + ul > li a:hover) {
    color: var(--red);
    border-bottom-color: var(--red);
  }

  /* Rule card — same as notes but adjusted copy label */
  .rule-card {
    margin-top: var(--s-8);
    background: #141414;
    color: var(--ink);
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rc-label { color: var(--brass); }
  .rc-link {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    flex-wrap: wrap;
    transition: color var(--t-med);
  }
  .rc-link:hover { color: var(--brass); }
  .rc-num { font-size: 36px; color: var(--brass); line-height: 1; letter-spacing: -0.01em; }
  .rc-title {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: 22px;
    color: var(--ink);
    letter-spacing: -0.005em;
    font-variation-settings: "opsz" 36, "SOFT" 30;
    flex: 1;
    min-width: 200px;
  }
  .rc-arrow {
    font-family: var(--f-body);
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--brass);
    font-weight: 600;
  }

  /* Prev / Next */
  .essay-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-5);
    margin-top: var(--s-9);
    padding-top: var(--s-6);
    border-top: var(--hair);
  }
  .en-all {
    grid-column: 1 / -1;
    align-items: center;
    text-align: center;
  }
  .en-all .en-title { font-family: var(--f-body); font-size: 16px; color: var(--red); }
  .en-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--s-4);
    border: 1px solid transparent;
    transition: border-color var(--t-med), background var(--t-med);
  }
  .en-link:hover { border-color: var(--red); background: var(--ink-08); }
  .en-next { text-align: right; align-items: flex-end; }
  .en-label { color: var(--ink-45); text-transform: uppercase; letter-spacing: 0.2em; font-size: 11px; }
  .en-title {
    font-family: var(--f-display);
    font-size: 18px;
    font-weight: 500;
    text-wrap: balance;
  }
  @media (max-width: 560px) {
    .essay-nav { grid-template-columns: 1fr; }
    .en-next { text-align: left; align-items: flex-start; }
  }
</style>
