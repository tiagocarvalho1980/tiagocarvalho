---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="The poster — All 55 rules on one page"
  description="Every rule title, numbered, on a single printable sheet. Pin it and work through them in whatever order your week demands."
>
  <section class="section poster-hero">
    <div class="wrap-read">
      <p class="type-kicker">The poster</p>
      <h1 class="type-display-l ph-title">The 55, on one page.</h1>
      <p class="type-body-l ph-body">
        Every rule title, numbered, on a single printable sheet. None of the methods.
        Pin it and work through them in whatever order your week demands.
      </p>
      <form
        class="poster-form"
        action="https://buttondown.com/api/emails/embed-subscribe/tiagocarvalho"
        method="post"
        target="popupwindow"
        onsubmit="window.open('https://buttondown.com/tiagocarvalho', 'popupwindow')"
      >
        <div class="field">
          <label for="pf-email">Your email</label>
          <input id="pf-email" name="email" type="email" autocomplete="email" required />
        </div>
        <input type="hidden" name="embed" value="1" />
        <input type="hidden" name="tag" value="poster" />
        <button type="submit" class="btn btn-red">Send the poster</button>
        <p class="type-caption pf-fine">
          A confirmation will arrive. Confirm it and the poster is on its way.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .poster-hero { padding-block: clamp(64px, 8vw, 120px) clamp(64px, 8vw, 120px); }
  .ph-title { margin-top: 18px; text-wrap: balance; }
  .ph-body { margin-top: var(--s-5); color: var(--ink-70); max-width: 55ch; }
  .poster-form { margin-top: var(--s-7); max-width: 480px; }
  .pf-fine { margin-top: var(--s-4); color: var(--ink-70); font-style: italic; }
</style>
