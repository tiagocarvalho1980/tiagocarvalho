---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmailBand from '../../components/EmailBand.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id.replace(/\.md$/, '') },
    props: { note },
  }));
}

const { note } = Astro.props as { note: any };
const { Content } = await render(note);

// Prev / next by date
const all = (await getCollection('notes')).sort(
  (a: any, b: any) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const idx = all.findIndex((n: any) => n.id === note.id);
const prev = all[idx - 1];
const next = all[idx + 1];

const num = String(note.data.rule).padStart(2, '0');

// Try to load the rule's title for the rule card
const entries = await getCollection('entries');
const rule = entries.find((e: any) => e.data.n === note.data.rule);
const ruleTitle = rule?.data.title;
const isRuleWritten = rule?.data.status === 'written';

const pageTitle = `${note.data.title} — Notes by Tiago Carvalho`;
const pageDescription = note.data.description ?? note.data.title;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: note.data.title,
  description: note.data.description,
  author: {
    '@type': 'Person',
    name: 'Tiago Carvalho',
    url: 'https://tiagocarvalho.co',
  },
  datePublished: note.data.date.toISOString(),
  articleSection: 'Notes',
};

const dateFmt = note.data.date.toLocaleDateString('en-GB', {
  day: '2-digit', month: 'long', year: 'numeric',
});
---
<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <article class="note">
    <div class="wrap-read">
      <div class="note-kicker">
        <span class="type-kicker">Note · {dateFmt}</span>
        {note.data.d && <span class="type-caption note-d">{note.data.d}</span>}
      </div>

      <h1 class="type-display-l note-h1">{note.data.title}</h1>

      <div class="note-body">
        <Content />
      </div>

      <div class="rule-card">
        <p class="type-eyebrow rc-label">This is a rule</p>
        <a class="rc-link" href={`/55/${num}`}>
          <span class="rc-num type-num">{num}</span>
          <span class="rc-title">
            {isRuleWritten && ruleTitle ? ruleTitle : `Rule ${num}`}
          </span>
          <span class="rc-arrow">Read the method &rarr;</span>
        </a>
      </div>

      <EmailBand
        variant="inline"
        kicker=""
        heading="Notes and rules, in your inbox."
        body=""
        label="Your email"
        button="Send"
      />

      <nav class="note-nav" aria-label="Note navigation">
        {(!prev && !next) ? (
          <a class="nn-link nn-all" href="/notes">
            <span class="type-caption nn-label">All notes</span>
            <span class="nn-title">→</span>
          </a>
        ) : (
          <Fragment>
            {prev ? (
              <a class="nn-link nn-prev" href={`/notes/${prev.id.replace(/\.md$/, '')}`}>
                <span class="type-caption nn-label">Previous</span>
                <span class="nn-title">{prev.data.title}</span>
              </a>
            ) : <span />}
            {next ? (
              <a class="nn-link nn-next" href={`/notes/${next.id.replace(/\.md$/, '')}`}>
                <span class="type-caption nn-label">Next</span>
                <span class="nn-title">{next.data.title}</span>
              </a>
            ) : <span />}
          </Fragment>
        )}
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .note { padding-block: clamp(48px, 6vw, 88px) 0; }
  .note-kicker {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: var(--s-4);
    border-bottom: var(--hair);
  }
  .note-d { text-transform: uppercase; letter-spacing: 0.22em; font-size: 11px; color: var(--red); font-weight: 600; }
  .note-h1 { margin-top: var(--s-6); text-wrap: balance; }
  .note-body {
    margin-top: var(--s-6);
    max-width: 640px;
  }
  .note-body :global(p) {
    font-family: var(--f-body);
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink);
    margin-bottom: var(--s-5);
  }
  .note-body :global(p:first-of-type) { font-size: 20px; }
  .note-body :global(strong) { font-weight: 600; }
  .note-body :global(em) { font-style: italic; }
  .note-body :global(a) {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--red);
    padding-bottom: 1px;
    transition: color var(--t-med), border-color var(--t-med);
  }
  .note-body :global(a:hover),
  .note-body :global(a:focus-visible) {
    color: var(--red);
    border-bottom-color: var(--ink);
    outline: none;
  }
  /* Editorial source-citation footer (e.g. "Pub figures: DIGI report ...") */
  .note-body :global(.note-source) {
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: var(--hair);
    font-family: var(--f-body);
    font-size: 13px;
    line-height: 1.5;
    font-style: italic;
    color: var(--ink-45);
  }
  .note-body :global(.note-source a) {
    color: var(--ink-70);
    border-bottom-color: var(--ink-15);
  }
  .note-body :global(.note-source a:hover) {
    color: var(--red);
    border-bottom-color: var(--red);
  }

  .rule-card {
    margin-top: var(--s-7);
    background: var(--ink);
    color: var(--paper);
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rc-label { color: var(--brass); }
  .rc-link {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    flex-wrap: wrap;
    transition: color var(--t-med);
  }
  .rc-link:hover { color: var(--brass); }
  .rc-num { font-size: 36px; color: var(--brass); line-height: 1; letter-spacing: -0.01em; }
  .rc-title {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: 22px;
    color: var(--paper);
    letter-spacing: -0.005em;
    font-variation-settings: "opsz" 36, "SOFT" 30;
    flex: 1;
    min-width: 200px;
  }
  .rc-arrow {
    font-family: var(--f-body);
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--brass);
    font-weight: 600;
  }

  .note-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-5);
    margin-top: var(--s-9);
    padding-top: var(--s-6);
    border-top: var(--hair);
  }
  .nn-all {
    grid-column: 1 / -1;
    align-items: center;
    text-align: center;
  }
  .nn-all .nn-title { font-family: var(--f-body); font-size: 16px; color: var(--red); }
  .nn-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--s-4);
    border: 1px solid transparent;
    transition: border-color var(--t-med), background var(--t-med);
  }
  .nn-link:hover { border-color: var(--red); background: var(--ink-08); }
  .nn-next { text-align: right; align-items: flex-end; }
  .nn-label { color: var(--ink-45); text-transform: uppercase; letter-spacing: 0.2em; font-size: 11px; }
  .nn-title {
    font-family: var(--f-display);
    font-size: 18px;
    font-weight: 500;
    text-wrap: balance;
  }
  @media (max-width: 560px) {
    .note-nav { grid-template-columns: 1fr; }
    .nn-next { text-align: left; align-items: flex-start; }
  }
</style>
